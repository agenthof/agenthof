# A framework agent (examples/langchain-agent, Python + LangChain) in a
# distroless Python base — no shell, no package manager, no pip at runtime.
# Dependencies are installed into /deps by a throwaway stage on the SAME Debian
# release and Python minor as the runtime image, so compiled wheels match;
# --only-binary makes a wheel that does not exist for this platform fail the
# build loudly instead of attempting a source build. /probe is the CI perimeter
# check (dial, touch); it is not the agent. No credential enters this image.
FROM docker.io/library/golang:1.27.2 AS probe
WORKDIR /src
COPY go.mod go.sum ./
COPY deploy/refbox/probe ./deploy/refbox/probe
RUN CGO_ENABLED=0 go build -o /out/probe ./deploy/refbox/probe

FROM docker.io/library/python:3.13-slim-trixie AS deps
COPY examples/langchain-agent/requirements.txt /requirements.txt
RUN pip install --no-cache-dir --only-binary=:all: --target=/deps -r /requirements.txt

FROM gcr.io/distroless/python3-debian13:nonroot
COPY --from=deps /deps /deps
COPY --from=probe /out/probe /probe
COPY examples/langchain-agent/agent.py /app/agent.py
# PYTHONDONTWRITEBYTECODE: the root filesystem is read-only in the recipe.
# PYTHONUNBUFFERED: the "listening on" line reaches `podman logs` promptly.
ENV PYTHONPATH=/deps PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENTRYPOINT ["/usr/bin/python3.13", "/app/agent.py", "-socket", "/run/agenthof/refbox-langchain.sock"]
