# mode: read-only mirrors echo (classified) and refuses other.

env AGENTHOF_TOOL_TOKEN=tool-secret

exec agenthof apply --config config --groups platform-eng
stdout 'registry ok: 1 agents, 1 workflows, 2 roles'

! exec agenthof run se tool-demo --input 'tool:echo,other' --as tester --config config --log-dir logs --artifact-dir artifacts
stdout 'finished: failed'

lastrun logs
exec agenthof audit $RUNID --log-dir logs
stdout 'tool echo — args [0-9a-f]{8} \(static_env\)'
stdout 'tool other refused — tool is not available to this run'

! grep 'tool-secret' logs/${RUNID}.jsonl

-- config/agents/user.yaml --
name: user
model: fast
instruction: use a tool
output: out
execution: fronted
tools:
  - resource: echo-tool
    mode: read-only
-- config/workflows/tool-demo.yaml --
name: tool-demo
steps:
  - name: call
    agent: user
-- config/roles/se.yaml --
name: se
workflows: [tool-demo]
allowed_groups: ["*"]
-- config/roles/ops.yaml --
name: platform-admin
allowed_groups: [platform-eng]
control: [apply, enable, disable, repair]
-- config/gateway.yaml --
models:
  fast:
    endpoint: https://example.test/v1
    model: m
    api_key_env: K
tools:
  echo-tool:
    kind: mcp
    url: http://127.0.0.1:0/
    credential_source: static_env
    token_env: AGENTHOF_TOOL_TOKEN
    read_only_tools: [echo]
defaults:
  model: fast
