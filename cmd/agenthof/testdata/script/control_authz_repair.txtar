# Ledger repair is authorized default-deny against the config dir's roles. A
# refused repair is printed, not recorded — the only ledger to record it in
# is the damaged one — and leaves the torn file exactly as it was.

exec agenthof apply --config examples/config --control-log control.jsonl --as dana@example.com --groups platform-eng
exec sh -c 'printf ''{"v":"control/1","seq":2,"partial'' >> control.jsonl'
! exec agenthof audit verify control --control-log control.jsonl
cp control.jsonl torn.before.jsonl

# unauthorized: printed, nothing appended, no fragment, still torn
! exec agenthof audit repair control --control-log control.jsonl --config examples/config --as mallory@example.com --groups finance
stdout 'audit repair control: not authorized: no role grants repair to the invoker'
! grep 'not_authorized' control.jsonl
cmp control.jsonl torn.before.jsonl
! exec sh -c 'ls control.jsonl.torn-* 2>/dev/null'
! exec agenthof audit verify control --control-log control.jsonl

# a config whose roles cannot be read: fail closed, same way
! exec agenthof audit repair control --control-log control.jsonl --config nowhere --as ops@example.com --groups platform-eng
stdout 'refusing to repair'
! exec sh -c 'ls control.jsonl.torn-* 2>/dev/null'
cmp control.jsonl torn.before.jsonl

# authorized: repaired and tainted
exec agenthof audit repair control --control-log control.jsonl --config examples/config --as ops@example.com --groups platform-eng
stdout 'control ledger tainted'
exec sh -c 'ls control.jsonl.torn-*'
! exec agenthof audit verify control --control-log control.jsonl
stdout 'TAINTED'
