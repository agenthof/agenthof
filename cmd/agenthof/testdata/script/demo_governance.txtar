# Demo Part 3: accountant role allows finance, refuses engineering — and the
# refusal is ledgered — docs/demo.md §3.

exec agenthof apply --config examples/config --groups platform-eng
stdout 'registry ok: 5 agents, 2 workflows, 3 roles'

exec agenthof run accountant reconcile-lite --input 'reconcile Q3 expenses' --as finance-lead@example.com --groups finance --config examples/config --log-dir logs --artifact-dir artifacts
stdout 'finished: succeeded'

! exec agenthof run accountant reconcile-lite --input 'reconcile Q3 expenses' --as engineer@example.com --groups engineering --config examples/config --log-dir logs --artifact-dir artifacts
stdout 'allowed groups \(finance\)'

lastrun logs
exec agenthof audit $RUNID --log-dir logs
stdout 'status: refused'
stdout 'refused: 1 refusal in this run'
stdout '  - run refused — role "accountant"'
stdout 'ledger integrity: verified \(1 events\)'
stdout 'ledger completeness: complete \(0 door call\(s\) accounted\)'
stdout 'run refused — role "accountant" requires membership in one of its allowed groups \(finance\)'
