# A card that carries only the host-program artifact form (no image) is
# inspected without writing anything, accepted by digest, recorded with the
# program and its build hashes, and applies. The guidance names the program to
# map to a local path and offers no image entry.

cardsigner cfg/gateway.yaml
mkcard hostprog card.json
carddigest card.json DIGEST
exec agenthof apply --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops

# inspect: the disclosure names the program and each expected hash; nothing is written
exec agenthof enroll card.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stdout 'program: +acme-triage'
stdout 'build darwin/arm64 sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc'
stdout 'build linux/amd64 sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
! stdout 'image:'
! exists cfg/agents/triage.yaml
! grep '"action":"enroll"' ctl/control.jsonl

# accept: recorded, written, guidance maps the program to a local path
exec agenthof enroll card.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops --accept $DIGEST
stdout 'enrolled "triage": 3 files created'
stdout 'seatbelt \(program "acme-triage"'
stdout 'map it to your local path'
stdout 'linux/amd64 sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd'
! stdout 'podman'
exists cfg/agents/triage.yaml
grep 'program: acme-triage' cfg/agents/triage.yaml
grep 'sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' cfg/agents/triage.yaml
grep 'sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd' cfg/agents/triage.yaml
! grep 'image:' cfg/agents/triage.yaml
grep '"action":"enroll"' ctl/control.jsonl
grep 'acme-triage' ctl/control.jsonl

# the result applies
exec agenthof apply --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stdout 'registry ok: 2 agents, 2 workflows, 3 roles'

-- cfg/gateway.yaml --
models:
  fast: {endpoint: http://localhost:4000, model: fast, api_key_env: K}
tools:
  code-search: {kind: mcp, url: https://mcp.example.internal/cs, credential_source: static_env, token_env: T, read_only_tools: [search]}
-- cfg/agents/orch.yaml --
name: orch
endpoint: http://localhost:9
-- cfg/workflows/main.yaml --
name: main
steps:
  - {name: s, agent: orch}
-- cfg/roles/admin.yaml --
name: admin
workflows: [main]
allowed_groups: [ops]
control: [apply, enroll]
-- cfg/roles/dev.yaml --
name: dev
workflows: [main]
allowed_groups: [devs]
