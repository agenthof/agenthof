# Control-plane authorization at apply (Article VI) reads the INSTALLED
# configuration. A fresh control root has nothing installed, so the first
# apply is a bootstrap: permitted, installed, recorded as such. From then on a
# caller whose groups the installed roles grant no `apply` is refused —
# recorded refused/not_authorized with the hash of the config they tried to
# apply — and nothing changes. examples/config's platform-admin role grants
# the four control operations to platform-eng and owns no workflows.

# bootstrap: dana installs the example config
exec agenthof apply --config examples/config --control-log control.jsonl --as dana@example.com --groups platform-eng
stdout 'registry ok: 5 agents, 2 workflows, 3 roles'
stdout 'control head: seq=1 sha256=[0-9a-f]{64}'
grep '"bootstrap":true' control.jsonl
exists installed/current

# wrong group: refused, recorded, the message names the op and nothing else
! exec agenthof apply --config examples/config --control-log control.jsonl --as mallory@example.com --groups finance
stdout 'apply: not authorized: no role grants apply to the invoker'
! stdout 'registry ok'
stdout 'control head: seq=2 sha256=[0-9a-f]{64}'
grep '"outcome":"refused"' control.jsonl
grep '"code":"not_authorized"' control.jsonl
grep '"message":"not authorized: no role grants apply to the invoker"' control.jsonl
grep '"config_hash":"sha256:[0-9a-f]{64}"' control.jsonl

# no groups at all (the OS user): refused the same way
! exec agenthof apply --config examples/config --control-log control.jsonl --as nobody@example.com
stdout 'not authorized: no role grants apply to the invoker'
stdout 'control head: seq=3'

# authorization precedes everything: with coder disabled in the installed
# snapshot, an unauthorized apply learns one refusal and never reaches
# validation or the store
exec agenthof registry disable coder --config examples/config --control-log control.jsonl --as dana@example.com --groups platform-eng
! exec agenthof apply --config examples/config --control-log control.jsonl --as mallory@example.com --groups finance
stdout 'not authorized'
! stdout 'depends on agent'
exec agenthof registry enable coder --config examples/config --control-log control.jsonl --as dana@example.com --groups platform-eng

# a platform-eng member re-applies — an ordinary apply, not a bootstrap
exec agenthof apply --config examples/config --control-log control.jsonl --as dana@example.com --groups platform-eng
stdout 'registry ok: 5 agents, 2 workflows, 3 roles'
stdout 'control head: seq=7 sha256=[0-9a-f]{64}'

# the refusals read back as refusals, attributed; the bootstrap reads distinctly
exec agenthof audit control --control-log control.jsonl
stdout 'seq 1 .*config applied \(bootstrap\) — dana@example.com \(asserted\)'
stdout 'config apply refused — mallory@example.com \(asserted\)'
stdout 'config apply refused — nobody@example.com \(asserted\)'
stdout 'seq 7 .*config applied — dana@example.com \(asserted\)'
stdout 'control ledger integrity: verified \(7 events\)'
stdout 'installed config: sha256:[0-9a-f]{64} — matches the last recorded install \(apply\)'
