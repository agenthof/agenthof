# A role whose control: names something outside the fixed set of control
# operations is rejected at apply: a typo must fail loudly here, not silently
# grant nothing at the gate. The separate, well-formed platform-admin role is
# what authorizes the applier — without it the broken role's own grant would
# never reach validation.

! exec agenthof apply --config config --control-log control.jsonl --as ops@example.com --groups platform-eng
stdout 'roles/typo\.yaml: typo: control names "deploy", which is not a control operation \(apply, enable, disable, repair, provision, prune, pull\)'
! stdout 'registry ok'
grep '"outcome":"rejected"' control.jsonl

-- config/agents/planner.yaml --
name: planner
model: fast
instruction: plan
output: plan
-- config/workflows/plan-only.yaml --
name: plan-only
steps:
  - name: plan
    agent: planner
-- config/roles/ops.yaml --
name: platform-admin
allowed_groups: [platform-eng]
control: [apply, enable, disable, repair]
-- config/roles/typo.yaml --
name: typo
workflows: [plan-only]
allowed_groups: [release]
control: [apply, deploy]
-- config/gateway.yaml --
models:
  fast:
    endpoint: https://example.test/v1
    model: m
    api_key_env: K
