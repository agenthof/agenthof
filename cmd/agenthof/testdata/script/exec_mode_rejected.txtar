# exec.mode is retired: exec is always first-hand via a runtime. A config that
# still carries the key — on an otherwise valid first-hand shape, or the old
# agent-reported shape — is rejected at apply when it is read, by name, with
# the replacement stated; the key is never silently dropped and no later
# error about a missing runtime masks it. An exec block that merely omits
# the runtime fields is rejected at validation for each missing field by name.

! exec agenthof apply --config stale-mode
stdout 'agents/runtime-shaped\.yaml: bad-exec-config: line 7: exec\.mode is no longer supported; exec is always first-hand via a runtime \(set runtime/url/timeout\)'
stdout 'agents/attested-shaped\.yaml: bad-exec-config: line 7: exec\.mode is no longer supported; exec is always first-hand via a runtime \(set runtime/url/timeout\)'
! stdout 'exec\.runtime is required'
! stdout 'exec\.url must be'
! stdout 'registry ok'

! exec agenthof apply --config missing-runtime
stdout 'agents/allow-only\.yaml: allow-only: exec\.runtime is required'
stdout 'agents/allow-only\.yaml: allow-only: exec\.url must be a unix:// socket path'
stdout 'agents/allow-only\.yaml: allow-only: exec\.timeout is required'
! stdout 'exec\.mode'
! stdout 'registry ok'

-- stale-mode/agents/runtime-shaped.yaml --
name: runtime-shaped
model: fast
instruction: run a command
output: out
execution: fronted
exec:
  mode: runtime
  runtime: refexec
  url: unix:///refexec-stub.sock
  timeout: 30s
  allow:
    - exe: "true"
-- stale-mode/agents/attested-shaped.yaml --
name: attested-shaped
model: fast
instruction: run a command
output: out
execution: fronted
exec:
  mode: attested
  allow:
    - exe: "true"
-- stale-mode/workflows/exec-demo.yaml --
name: exec-demo
steps:
  - name: run
    agent: runtime-shaped
-- stale-mode/roles/se.yaml --
name: se
workflows: [exec-demo]
allowed_groups: ["*"]
-- stale-mode/gateway.yaml --
models:
  fast:
    endpoint: https://example.test/v1
    model: m
    api_key_env: K
-- missing-runtime/agents/allow-only.yaml --
name: allow-only
model: fast
instruction: run a command
output: out
execution: fronted
exec:
  allow:
    - exe: "true"
-- missing-runtime/workflows/exec-demo.yaml --
name: exec-demo
steps:
  - name: run
    agent: allow-only
-- missing-runtime/roles/se.yaml --
name: se
workflows: [exec-demo]
allowed_groups: ["*"]
-- missing-runtime/gateway.yaml --
models:
  fast:
    endpoint: https://example.test/v1
    model: m
    api_key_env: K
