# A validly signed card still cannot ask for more than enrollment grants: a
# wildcard tool, a spawn right, a tool the gateway lacks, a missing or unpinned
# artifact and an unsupported interface each fail fast, naming the problem,
# with nothing written and nothing recorded.

cardsigner cfg/gateway.yaml
exec agenthof apply --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
snapshot before cfg ctl/control.jsonl

mkcard wildcard wildcard.json
! exec agenthof enroll wildcard.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stderr 'is a wildcard'
unchanged before cfg ctl/control.jsonl

mkcard spawn spawn.json
! exec agenthof enroll spawn.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stderr 'may not grant may_spawn'
unchanged before cfg ctl/control.jsonl

mkcard notool notool.json
! exec agenthof enroll notool.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stderr 'tool resource "no-such-tool" is not defined'
unchanged before cfg ctl/control.jsonl

mkcard noartifact noartifact.json
! exec agenthof enroll noartifact.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stderr 'has no artifact'
unchanged before cfg ctl/control.jsonl

mkcard unpinned unpinned.json
! exec agenthof enroll unpinned.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stderr 'not pinned to a digest'
unchanged before cfg ctl/control.jsonl

mkcard badinterface badinterface.json
! exec agenthof enroll badinterface.json --name triage --role dev --config cfg --control-log ctl/control.jsonl --as ops-user --groups ops
stderr 'interface "grpc" is not supported'
unchanged before cfg ctl/control.jsonl

-- cfg/gateway.yaml --
models:
  fast: {endpoint: http://localhost:4000, model: fast, api_key_env: K}
tools:
  code-search: {kind: mcp, url: https://mcp.example.internal/cs, credential_source: static_env, token_env: T, read_only_tools: [search]}
-- cfg/agents/orch.yaml --
name: orch
endpoint: http://localhost:9
-- cfg/workflows/main.yaml --
name: main
steps:
  - {name: s, agent: orch}
-- cfg/roles/admin.yaml --
name: admin
workflows: [main]
allowed_groups: [ops]
control: [apply, enroll]
-- cfg/roles/dev.yaml --
name: dev
workflows: [main]
allowed_groups: [devs]

