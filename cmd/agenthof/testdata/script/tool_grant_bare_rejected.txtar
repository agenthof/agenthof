# A bare tool grant — a resource id on its own — is no longer a grant: apply
# rejects it at load and names both replacements, so every-tool access is
# always written out as mode: all.

! exec agenthof apply --config config
stdout 'agents/user\.yaml: bad-tool-grant: line 6: a bare tool grant is no longer accepted'
stdout '\{resource: "echo-tool", tools: \[\.\.\.\]\}'
stdout '\{resource: "echo-tool", mode: all\}'

-- config/agents/user.yaml --
name: user
model: fast
instruction: use a tool
output: out
execution: fronted
tools: [echo-tool]
-- config/workflows/tool-demo.yaml --
name: tool-demo
steps:
  - name: call
    agent: user
-- config/roles/se.yaml --
name: se
workflows: [tool-demo]
allowed_groups: ["*"]
-- config/gateway.yaml --
models:
  fast:
    endpoint: https://example.test/v1
    model: m
    api_key_env: K
tools:
  echo-tool:
    kind: mcp
    url: http://127.0.0.1:0/
    credential_source: static_env
    token_env: AGENTHOF_TOOL_TOKEN
defaults:
  model: fast
