# `agenthof audit repair control` recovers a torn-tail control
# log by moving the damaged fragment aside, truncating to the last valid
# record, and appending an attributed "repair" event that taints the
# ledger forever — spec §3.6.
#
# All the `apply` calls needed to seed control.jsonl/clean.jsonl/
# broken.jsonl run up front, while examples/config's agent "coder" is
# still enabled: a `registry disable coder` mutates that shared config
# directory for the rest of the script, and once it does, a later
# `apply` against it would fail registry.Build's dependency check
# ("fix-bug" depends on "coder"). So there is exactly one mutating
# disable in this whole script, run last.

exec agenthof apply --config examples/config --control-log control.jsonl --as dana@example.com
stdout 'registry ok: 5 agents, 2 workflows, 2 roles'
stdout 'control head: seq=1 sha256=[0-9a-f]{64}'

# A second control log that will stay clean, for the "not torn" case.
exec agenthof apply --config examples/config --control-log clean.jsonl --as dana@example.com

# A third control log, seeded with two genuine records via two plain
# applies (never touching registry state), for the "chain break" case.
exec agenthof apply --config examples/config --control-log broken.jsonl --as dana@example.com
exec agenthof apply --config examples/config --control-log broken.jsonl --as dana@example.com
stdout 'control head: seq=2 sha256=[0-9a-f]{64}'

# Corrupt control.jsonl's tail: append a partial line with no trailing
# newline.
exec sh -c 'printf ''{"v":"control/1","seq":2,"partial'' >> control.jsonl'

# Before repair: verify reports torn (exit 1), and a write path (disable)
# refuses with the "audit repair control" hint rather than mutating
# anything or appending on top of the damage.
! exec agenthof audit verify control --control-log control.jsonl
! exec agenthof registry disable coder --config examples/config --control-log control.jsonl --as dana@example.com
stdout 'audit repair control'

exec agenthof audit repair control --control-log control.jsonl --as ops@example.com
stdout 'repaired: moved \d+ bytes \(sha256=[0-9a-f]{64}\) to .*control\.jsonl\.torn-\d+; control ledger tainted'
stdout 'control head: seq=2 sha256=[0-9a-f]{64}'
# exists has no glob support, so confirm the sibling fragment file via a
# shell glob instead (nonzero exit, and thus test failure, if it's absent).
exec sh -c 'ls control.jsonl.torn-*'

# The live file is structurally clean again, so a write path works — this
# is the one and only mutating registry call in the whole script.
exec agenthof registry disable coder --config examples/config --control-log control.jsonl --as dana@example.com
stdout 'agent coder disabled'

# ...but the ledger is tainted forever: verify now exits 3.
! exec agenthof audit verify control --control-log control.jsonl
stdout 'TAINTED'

# Repairing an already-clean (non-torn) log is refused.
! exec agenthof audit repair control --control-log clean.jsonl --as ops@example.com
stdout 'not torn; nothing to repair'

# A chain break (not a simple torn tail) is not auto-repairable: a
# well-formed record whose "prev" disagrees with the chain.
exec sh -c 'printf ''{"v":"control/1","seq":3,"prev":"deadbeef","time":"2026-01-01T00:00:00Z","action":"enable","outcome":"success","invoker":{},"witness":{}}\n'' >> broken.jsonl'
! exec agenthof audit repair control --control-log broken.jsonl --as ops@example.com
stdout 'not auto-repairable'

# A control log that was never written to reports plainly, exit 1.
! exec agenthof audit repair control --control-log never-written.jsonl --as ops@example.com
stdout 'no control ledger at never-written.jsonl — nothing recorded yet'
